# AI API 이미지(설계 11.4절). BE·FE와 달리 verify 산출물이 없고 ai/ 소스에서 의존성을 설치해 조립한다(서버 A의 deploy 러너, infra/ci/build-images.sh).
# 빌드 컨텍스트는 build-images.sh가 ai/에서 필요한 파일만(pyproject.toml, uv.lock, src/, server/, samples/place/mock.json) 임시 폴더로 복사해 만든다.
# 그래서 .env와 시험·실험 파일이 컨텍스트에 들어갈 수 없다. 모델은 넣지 않는다: 임베딩은 Modal을 부른다. 필수 의존성과 server 그룹만 설치한다.
# 베이스 이미지 핀은 infra/ci/tool-images.sh의 PYTHON_IMAGE와 같다(tests/test_tool_images_sync.py가 검사한다).
# 루트 파일시스템은 읽기 전용이다(compose.app.yml).
ARG BASE_IMAGE=python:3.12.15-slim
FROM ${BASE_IMAGE}

ARG SHA
LABEL org.opencontainers.image.revision=${SHA}
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/app/.venv PATH=/app/.venv/bin:$PATH

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /app
RUN pip install --no-cache-dir uv==0.12.5
# 의존성 층: pyproject와 잠금 파일이 같으면 캐시를 쓴다
COPY pyproject.toml uv.lock ./
# 필수 의존성에 torch가 있으면 수 GB 이미지가 되고 A의 메모리·디스크 계획이 깨진다. 내려받기 전에 잠금 파일만 보고 막는다(설계 11.4절 전제 2: 로컬 인코더는 선택 의존성이어야 한다)
RUN uv export --frozen --no-dev --no-default-groups --group server --no-emit-project 2>/dev/null | grep -qi '^torch==' \
    && { echo "FAIL: 서버 의존성에 torch가 들어 있다. 로컬 인코더(sentence-transformers)를 선택 의존성으로 분리한다(design.md 11.4절)" >&2; exit 1; } \
    || true
RUN uv sync --frozen --no-dev --no-default-groups --group server --no-install-project
COPY src/ src/
COPY server/ server/
COPY samples/place/mock.json samples/place/mock.json
RUN uv sync --frozen --no-dev --no-default-groups --group server \
    && python -c "import fastapi, uvicorn, psycopg, psycopg_pool, httpx, numpy, fit_ai"
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "server.main:app", "--host", "0.0.0.0", "--port", "8000"]
