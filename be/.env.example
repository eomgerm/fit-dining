# cp .env.example .env 로 복사한 뒤 REPLACE_ME를 실제 값으로 바꾼다. .env는 git이 무시한다.
# 로컬(infra/local)에서는 infra/local/.env의 FIT_DEV_APP_PASSWORD 값을 넣는다.
SPRING_DATASOURCE_PASSWORD=REPLACE_ME
# 장소 검색 Mock. local과 dev에서만 켠다.
PLACE_MOCK_ENABLED=true
# 리뷰 메모리 저장소. local과 dev에서만 켠다. 재시작하면 시드만 남는다.
REVIEW_MOCK_ENABLED=true

# Base64로 인코딩한 최소 32바이트 난수
JWT_SECRET=REPLACE_ME
# 로컬 값. 운영에서는 실제 HTTPS origin과 true를 지정한다.
AUTH_FRONTEND_ORIGIN=http://localhost:3000
AUTH_COOKIE_SECURE=false
# 선택: 아래 세 키를 함께 지정한다. 가입과 동일한 입력 규칙을 적용한다.
# AUTH_DEMO_EMAIL=REPLACE_ME
# AUTH_DEMO_PASSWORD=REPLACE_ME
# AUTH_DEMO_NICKNAME=REPLACE_ME
# AUTH_TERMS_VERSION=2026-10-23

# Optional social providers: set both values or leave both empty.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_KAKAO_CLIENT_ID=
AUTH_KAKAO_CLIENT_SECRET=
AUTH_NAVER_CLIENT_ID=
AUTH_NAVER_CLIENT_SECRET=
