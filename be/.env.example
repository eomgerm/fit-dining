# cp .env.example .env 로 복사한 뒤 REPLACE_ME를 실제 값으로 바꾼다. .env는 git이 무시한다.
# 로컬(infra/local)에서는 infra/local/.env의 FIT_DEV_APP_PASSWORD 값을 넣는다.
SPRING_DATASOURCE_PASSWORD=REPLACE_ME
# 장소 검색 Mock. local과 dev에서만 켠다.
PLACE_MOCK_ENABLED=true

# Base64로 인코딩한 최소 32바이트 난수
JWT_SECRET=REPLACE_ME
# 로컬 값. 운영에서는 실제 HTTPS origin과 true를 지정한다.
AUTH_FRONTEND_ORIGIN=http://localhost:3000
AUTH_COOKIE_SECURE=false
# 선택: 아래 세 키를 함께 지정한다. 가입과 동일한 입력 규칙을 적용한다.
# AUTH_DEMO_EMAIL=REPLACE_ME
# AUTH_DEMO_PASSWORD=REPLACE_ME
# AUTH_DEMO_NICKNAME=REPLACE_ME
# AUTH_TERMS_VERSION=2026-11-02

# Optional social providers: set both values or leave both empty.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_KAKAO_CLIENT_ID=
AUTH_KAKAO_CLIENT_SECRET=
# Enable only after configuring Kakao account email as optional consent in this app's console.
# Default false avoids KOE205 and keeps login working before console setup.
AUTH_KAKAO_EMAIL_SCOPE_ENABLED=false
AUTH_NAVER_CLIENT_ID=
AUTH_NAVER_CLIENT_SECRET=

# 리뷰 사진(Garage). 로컬은 infra/local/.env의 S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY 값을 넣는다.
# 비워 두면 사진 없는 리뷰만 쓸 수 있고 사진 업로드는 503이다.
# S3_PUBLIC_ENDPOINT는 브라우저 업로드를 넘겨 주는 next dev가 Garage에 보내는 Host다(리뷰 D-45).
S3_ENDPOINT=http://127.0.0.1:13900
S3_PUBLIC_ENDPOINT=http://127.0.0.1:13900
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Simple auth: opt in on local/dev only; prod rejects it and AUTH_DEV_KEY.
AUTH_SIMPLE_ENABLED=false
# Local: optional, no length limit. Dev server: secret, at least 32 characters, required when simple auth is enabled.
# AUTH_DEV_KEY=REPLACE_ME
# Simple mode defaults: dev@fitdining.local / 개발자.
# Local password: fitdining-dev1. Dev requires AUTH_DEMO_PASSWORD.
