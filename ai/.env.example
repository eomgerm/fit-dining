# 검색 서버와 AI 스크립트가 읽는 환경변수. cp .env.example .env 로 복사한 뒤 값을 채운다.
# .env는 git이 무시한다. 배포(Modal) 때는 이 파일 대신 Modal Secret에 같은 키를 넣는다.
# "배포:"는 배포 때 넣을 값이다. 값 뒤에 주석을 붙이지 않는다.

# GMS(SSAFY LLM API). 공유 모듈 fit_ai.gms가 읽는다. 키 이름은 BE와 같다(docs/infra/contracts/env.md).
# 주소는 기준 URL(https://gms.ssafy.io/gmsapi/api.openai.com/v1)과 전체 엔드포인트를 모두 받는다.
GMS_BASE_URL=REPLACE_ME
GMS_API_KEY=REPLACE_ME
# true가 아니면 GMS를 부르지 않는다(킬스위치). 꺼지면 해석은 낱말 규칙으로, 정렬은 유사도로 한다.
# 켰는데 주소나 키가 비었거나 주소 형식이 틀리면 서버가 시작할 때 멈춘다. 배포: true
GMS_ENABLED=false
# GMS 한 번 부를 때 기다리는 시간(초). 실패하면 공유 모듈이 한 번 더 부른다.
GMS_TIMEOUT_SECONDS=5.0

# 검색 서버(server/). 띄우는 법: ai/에서 uv run --env-file .env uvicorn server.main:app
# true면 시작할 때 요청문 인코더(모델 2GB 남짓)를 올린다. 아니면 검색이 503이다. 배포: true
# GPU는 CUDA_VISIBLE_DEVICES로 고른다(SSAFY GPU 서버는 5번). CUDA 12.8 드라이버는 uv sync --extra cu128.
EMBEDDING_ENABLED=true
# 장소와 회원 취향을 읽을 Postgres. 로컬 개발 DB는 scripts/dev_db.py가 찍어 주는 값을 쓴다.
# 비우면 회원 취향을 읽지 못해 회원 검색은 취향 없이 정렬하고 fallbacks에 TASTE_INVALID를 담는다.
# 배포: 비운다. 지금 장소 DB 코드는 개발 DB에만 있는 뷰를 읽어서 실제 DB에서는 503이다.
DATABASE_URL=
# DATABASE_URL이 비었을 때 장소를 읽을 JSON 파일. 상대 경로는 서버를 띄운 폴더(보통 ai/) 기준이다.
# Modal에서는 이 파일을 이미지에 같이 넣어야 한다.
# BE Mock 장소는 samples/place/mock.json이다. DATABASE_URL과 둘 다 비우면 검색이 503이다.
# Mock 장소 id는 BE Mock과 같아서 BE가 Mock을 쓰는 local·dev에서만 맞는다. 배포: dev는 samples/place/mock.json, prod는 쓰지 않는다.
PLACES_FILE=
# 컨테이너 하나가 장소를 읽으려고 여는 DB 접속 수. 취향은 1개를 더 연다. Postgres 상한(60)을 컨테이너 수로 나눠 정한다.
DB_POOL_SIZE=2
# 컨테이너 하나가 동시에 처리하는 검색 수. 넘으면 503 BUSY다(임시 값).
MAX_CONCURRENT_REQUESTS=8

# 데이터 스크립트(scripts/, experiments/). 수집 데이터 위치이고 기본은 ~/fit-ai-data다.
# .env는 워크스페이스마다 따로라 사용자 환경변수로 두는 편이 낫다(README).
# FIT_AI_DATA_DIR=
