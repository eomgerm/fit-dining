# cp .env.example .env 로 복사한 뒤 REPLACE_ME를 실제 값으로 바꾼다. .env는 git이 무시한다.
# 이름은 docs/infra/contracts/env.md를 따른다. 주소는 기준 URL과 전체 엔드포인트를 모두 받는다.
# GMS는 /gmsapi/ 뒤를 대상 도메인으로 읽는다. 기준 URL은 https://gms.ssafy.io/gmsapi/api.openai.com/v1 형태다.
GMS_BASE_URL=REPLACE_ME
GMS_API_KEY=REPLACE_ME
# true가 아니면 GMS를 부르지 않는다(킬스위치). 꺼지면 해석은 낱말 규칙으로, 정렬은 유사도로 한다.
# 켰는데 주소나 키가 비었거나 주소 형식이 틀리면 서버가 시작할 때 멈춘다.
GMS_ENABLED=false

# 아래는 비교 검색 API(server/)가 쓴다. 띄우는 법: ai/에서 uv run --env-file .env uvicorn server.main:app
# GMS 한 번 부를 때 기다리는 시간(초). 공유 모듈은 실패하면 한 번 더 부른다.
GMS_TIMEOUT_SECONDS=5.0
# true면 서버가 시작할 때 요청문 인코더(fit_ai.embedding)를 올린다. 아니면 검색이 503이다.
# GPU는 CUDA_VISIBLE_DEVICES로 고른다(SSAFY GPU 서버는 5번). CUDA 12.8 드라이버는 uv sync --extra cu128.
EMBEDDING_ENABLED=false
# 장소를 읽을 Postgres. 로컬은 scripts/dev_db.py가 찍어 주는 값을 쓴다.
DATABASE_URL=
# DATABASE_URL이 비었을 때 장소를 읽을 JSON 파일(ai/ 기준 경로). 실제 장소 DB가 생기기 전의 임시 방법이다.
# BE Mock 장소 30곳 예시는 samples/place/mock.json이다. 둘 다 비우면 검색이 503이다.
PLACES_FILE=
# DATABASE_URL이 비었을 때 회원 취향을 읽을 JSON 파일(ai/ 기준 경로). 샘플 사용자 7명은 samples/taste/profiles.json이고
# 회원 id는 파일의 키("1"~"7")다. 둘 다 비우면 회원 id로 온 검색은 취향 없이 정렬한다.
TASTE_FILE=
# 컨테이너 하나가 장소를 읽으려고 여는 DB 접속 수. 취향은 1개를 더 연다. Postgres 상한(60)을 컨테이너 수로 나눠 정한다.
DB_POOL_SIZE=2
# 컨테이너 하나가 동시에 처리하는 검색 수. 넘으면 503 BUSY다(임시 값).
MAX_CONCURRENT_REQUESTS=8
