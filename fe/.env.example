# cp .env.example .env.local 로 복사한 뒤 값을 채운다. .env.local은 git이 무시한다.
# 런타임 값은 서버가 읽고, 공개 값만 GET /config.json으로 브라우저에 나간다.

# 네이버 지도 Client ID(NCP 콘솔 Maps > Application > 인증 정보). Web 서비스 URL에 http://localhost를 등록해야 한다.
# 비워 두면 지도 영역이 비고 목록, 후속 조건, 요청 기록은 그대로 동작한다.
NAVER_MAP_CLIENT_ID=

# /config.json의 env 값(dev 또는 prod). 로컬 개발에서만 생략 시 dev다.
# production에서는 필수이며 누락·잘못된 값은 /config.json이 500을 반환한다.
# APP_ENV=dev

# (선택) 브라우저에 공개할 런타임 설정. 빈 값은 /config.json에서 생략한다.
POSTHOG_KEY=
POSTHOG_HOST=
PUSH_PUBLIC_KEY=

# 빌드 시 주입할 커밋 SHA. build ID와 deployment ID에 사용하며 로컬 빌드에서는 생략한다.
# DEPLOYMENT_VERSION=<commit-sha>

# (선택) Next 서버가 BE를 부를 주소. 서버 컴포넌트(장소 상세)의 조회와 next dev의 /api 프록시가 쓴다.
# 없으면 next dev 프록시는 http://localhost:8080으로 보내고, 서버의 장소 조회는 건너뛰어 브라우저가 받는다.
# BE_INTERNAL_URL=http://localhost:8080
